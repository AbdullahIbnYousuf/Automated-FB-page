# Hosted-safe backend defaults. Copy to .env and provide your own Supabase values.
APPLICATION_MODE=development
AUTOMATION_ENABLED=false
PUBLISH_MODE=dry_run
APP_TIMEZONE=Asia/Dhaka

# Supabase PostgreSQL. Use the shared session pooler (port 5432) on IPv4 hosts.
DATABASE_URL=

# Exact comma-separated browser origins; wildcards are ignored.
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
LOG_LEVEL=INFO
MAX_UPLOAD_BYTES=5242880
MAX_IMAGE_PIXELS=40000000

# Single-operator Supabase Auth and private Storage.
AUTH_REQUIRED=true
OPERATOR_EMAIL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Current hosted Storage requires a backend-only service_role JWT here.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=post-images
SUPABASE_REQUEST_TIMEOUT_SECONDS=15

# Presence is reported only as booleans. Phase 4 is not implemented.
FACEBOOK_GRAPH_API_VERSION=v26.0
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
